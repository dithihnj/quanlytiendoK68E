{
  "version": 2,
  "name": "quan-ly-do-an-k68",
  "crons": [
    {
      "path": "/api/send-report?action=daily_digest",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
